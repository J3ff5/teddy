# App
PORT=3000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL=postgres://teddy:teddy@localhost:5432/teddy
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d

# Seed admin (created on first boot if it does not exist)
ADMIN_EMAIL=admin@teddy.com
ADMIN_PASSWORD=admin123

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=teddy-back-end
